# PostgreSQL Local Configuration (SW-1.2.1)
POSTGRES_USER=switchyard
POSTGRES_PASSWORD=switchyard_dev_password
POSTGRES_DB=switchyard
POSTGRES_PORT=5432
GATEWAY_POSTGRES_USER=gateway_app
GATEWAY_POSTGRES_PASSWORD=switchyard_app_password

# Redis Local Configuration (SW-1.2.1)
REDIS_PASSWORD=switchyard_dev_password
REDIS_APP_USER=switchyard_app
REDIS_APP_PASSWORD=switchyard_app_password
REDIS_PORT=6379
REDIS_MAXMEMORY=64mb

# Gateway Security & Browser Origin (SW-1.5.3)
# Development: Approved loopback origin (default: http://127.0.0.1:3000)
# Production: Explicit HTTPS origin required (e.g. https://app.example.com)
BROWSER_ORIGIN=http://127.0.0.1:3000

# Provider Credential Envelope Encryption (SW-1.7.1 / SW-1.7.2)
# Optional until provider-credential management routes are enabled (SW-1.7.3).
# Each KEK is exactly 32 random bytes encoded as canonical, unpadded base64url (43 characters).
# Supply all active-version values together; omit the entire block to leave the vault uninitialised.
# Never commit real KEK material or reuse the same key for V1 and V2.
# MASTER_KEK_V1=
# MASTER_KEK_V2=
# ACTIVE_KEK_VERSION=1

# Mock Upstream Configuration (SW-1.8-A)
# Development and testing only. Prohibited in production profile.
# MOCK_PORT=4000
# MOCK_HOST=127.0.0.1
