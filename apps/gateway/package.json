{
  "name": "@switchyard/gateway",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --no-error-on-unmatched-pattern",
    "migrate": "node src/db/migrate.ts --apply",
    "start": "node dist/index.js",
    "test": "vitest run --passWithNoTests",
    "test:integration": "INTEGRATION_TESTS=required vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fastify": "^5.12.8",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
