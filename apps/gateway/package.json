{
  "name": "@switchyard/gateway",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bootstrap:roles": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/db/bootstrap.ts --apply",
    "lint": "eslint . --no-error-on-unmatched-pattern",
    "migrate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/db/migrate.ts --apply",
    "migrate:adopt-legacy": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/db/migrate.ts --apply --adopt-legacy",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker-main.js",
    "test": "vitest run --passWithNoTests",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:integration": "INTEGRATION_TESTS=required vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "fastify": "^5.12.8",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
